# ==============================================================================
# CARE Evaluation Platform - Master .gitignore
# Ignore rules for Python/FastAPI backend, React/Vite frontend, IDEs, and OS
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets (NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# ------------------------------------------------------------------------------
# Python & Backend Artifacts
# ------------------------------------------------------------------------------
# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# SQLite Database & Data Storage
*.db
*.sqlite
*.sqlite3
care_evaluator.db

# PDF & Generated Export Files
*.pdf
pdf_reports/
exports/*.csv

# ------------------------------------------------------------------------------
# Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/

# Build Outputs
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
build/
out/
.vite/
frontend/.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostics & Linter caches
.eslintcache
.oxlintcache

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains / PyCharm / WebStorm
.idea/
*.iws
*.iml
*.ipr

# Visual Studio / Visual Studio Code
*.suo
*.ntvs*
*.njsproj
*.sln
*.user
*.userosv

# Vim & Emacs
*.sw?
*~
.#*

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Temporary Files & Artifacts
# ------------------------------------------------------------------------------
tmp/
temp/
scratch/
