# Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=sqlite:///./care_evaluator.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/care_evaluator

# App
APP_ENV=development
APP_VERSION=1.0.0
APP_NAME=CARE Evaluator

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Future: JWT Auth (scaffold ready)
# JWT_SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
