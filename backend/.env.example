# Environment Configuration – CARE Housing Society AI Complaint Agent

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=2.0.0
APP_NAME=CARE Housing Society

# ─── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite)
DATABASE_URL=sqlite:///./care_housing.db

# Production (PostgreSQL + pgvector)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/care_housing

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: gemini | openai | claude | demo
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Gemini Model
GEMINI_MODEL=gemini-1.5-pro-latest

# OpenAI Model (fallback)
OPENAI_MODEL=gpt-4o

# ─── Feature Flags ────────────────────────────────────────────────────────────
VECTOR_SEARCH_ENABLED=false
REDIS_CACHE_ENABLED=false
BACKGROUND_JOBS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=false
SMS_NOTIFICATIONS_ENABLED=false
WHATSAPP_NOTIFICATIONS_ENABLED=false

# ─── Redis (optional caching) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ─── Rate Limiting ────────────────────────────────────────────────────────────
CHAT_RATE_LIMIT=30/minute
API_RATE_LIMIT=100/minute

# ─── Arize Telemetry (existing) ───────────────────────────────────────────────
ARIZE_SPACE_ID=U3BhY2U6NTA3MDk6dFNJWA==
ARIZE_API_KEY=ak-f773bd0e-12e8-4b77-8857-f16fce5c1a70-HP213y8RcLfke-sCkb3MykT9wCMEGVsu
ARIZE_PROJECT_NAME=CARE-Housing

# ─── Email (optional) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@carehousing.com

# ─── Society Defaults ─────────────────────────────────────────────────────────
DEFAULT_CITY_CODE=MUM
DEFAULT_SOCIETY_NAME=Sunrise Heights Society

# ─── Automated Evaluation Pipeline ────────────────────────────────────────────
# ⚠️  SECRET PROTECTION: Never commit real values. Add .env to .gitignore.

# Token cost rates for cost_per_task calculation (0 = KPI marked as "unavailable")
LLM_INPUT_COST_PER_1K_TOKENS=0.0
LLM_OUTPUT_COST_PER_1K_TOKENS=0.0

# LLM-as-a-Judge (Phase 3 – leave blank to mark reasoning KPIs as "unavailable")
# Provider options: openai | gemini | anthropic | (blank = disabled)
# API keys reuse existing OPENAI_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY above
LLM_JUDGE_PROVIDER=
LLM_JUDGE_MODEL=

# OpenTelemetry exporter (default: arize – uses existing Arize credentials above)
# Options: arize | console | otlp
OTEL_EXPORTER_TYPE=arize

# OTLP endpoint (only needed when OTEL_EXPORTER_TYPE=otlp)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
